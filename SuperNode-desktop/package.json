{
  "name": "paperclip-desktop",
  "version": "0.3.1",
  "description": "PaperClip Desktop — AI-powered coding assistant with local-first architecture",
  "main": "dist/main/index.js",
  "author": "PaperClip Authors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "bundle": "npx tsx ../../SuperNode-desktop/scripts/desktop/bundle-desktop.ts",
    "electron:pack": "electron-builder --config electron-builder.yml",
    "dist": "pnpm build && pnpm bundle && pnpm electron:pack",
    "icons": "node --experimental-strip-types ../../SuperNode-desktop/scripts/desktop/generate-icons.ts"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "39.4.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.0"
  }
}
